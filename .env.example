# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit secrets.

# --- Supabase (public client, safe to ship to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase service-role key (server-only, bypasses RLS) ---
# Source: https://supabase.com/dashboard/project/_/settings/api-keys
# Required by admin moderation actions, shop session minting, booking
# inserts — anything that needs to write past RLS deny-all policies.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Session signing secret ---
# Minimum 32 chars. Used to sign + verify both the admin and shop session
# JWTs (the JWTs are separated by `aud` claim, not by key). Rotating this
# value invalidates every active session.
ADMIN_SESSION_SECRET=replace-with-32+-char-random-string

# --- Canonical site URL (public, safe in the browser bundle) ---
# Origin used to build shareable absolute links + QR codes (e.g. the shop
# share page). No trailing slash. Falls back to https://$VERCEL_URL on Vercel,
# then http://localhost:4000 in local dev.
NEXT_PUBLIC_SITE_URL=https://quego.app

# --- LINE Messaging API channel (OPP-02 notifications) ---
# Source: LINE Developers Console → your Messaging API channel.
# Channel secret — verifies the x-line-signature HMAC on inbound webhooks
# (POST /api/line/webhook). Server-only; no NEXT_PUBLIC_ prefix.
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Long-lived channel access token — authorizes outbound push/reply calls.
# Server-only; no NEXT_PUBLIC_ prefix.
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OA basic id incl. the leading @ (e.g. @quego). PUBLIC — it appears in the
# user-facing "เชื่อม LINE" deep link, hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_LINE_OA_BASIC_ID=@your-oa

# --- LINE Login channel (shop connects LINE to receive notifications) ---
# Source: LINE Developers Console → a LINE Login channel under the SAME provider
# as the Messaging API channel above, with that Messaging channel linked to it
# (so the userId from login is push-addressable). Server-only; no NEXT_PUBLIC_.
# The OAuth redirect URI is derived from NEXT_PUBLIC_SITE_URL as
#   <NEXT_PUBLIC_SITE_URL>/api/shop/line/callback
# and must be registered verbatim in the LINE Login channel's Callback URL list.
LINE_LOGIN_CHANNEL_ID=xxxxxxxxxx
LINE_LOGIN_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Firebase Phone Auth (OTP — verifies phone ownership at SIGNUP only) ---
# Web app config — PUBLIC by Firebase's design (the API key identifies the
# project; it authorizes nothing), so these ship in the browser bundle.
# Source: Firebase Console → Project settings → General → Your apps (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBOclCqxzlhXtufqqMg0eN1G6Z_tQdHZII
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=queva-5a812.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=queva-5a812
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1095037456660
NEXT_PUBLIC_FIREBASE_APP_ID=1:1095037456660:web:7b6473e43db276b011b201

# OTP ID-token verification needs NO service-account secret. A Firebase ID token
# is a standard RS256 JWT; the server verifies it with `jose` against Google's
# PUBLIC signing keys, checking iss/aud against NEXT_PUBLIC_FIREBASE_PROJECT_ID
# (above). The Firebase Admin SDK was removed — it failed to load in the
# Turbopack serverless build, and public-key verification is the path Google
# documents for third-party JWT libraries.
#
# GO-LIVE HARDENING (Firebase Console — no env var, but REQUIRED before launch).
# `sendCode` (signInWithPhoneNumber) fires straight from the browser to Firebase
# and never passes through our server rate limiter, so SMS toll-fraud must be
# stopped in the console. The in-app resend cooldown + per-mount cap only guard
# honest users' accidental taps. In the Firebase Console, before go-live:
#   1. Authentication → Settings → enable App Check (reCAPTCHA Enterprise) and
#      ENFORCE it for Phone Auth, so only your app origins can request SMS.
#   2. Authentication → Settings → SMS region policy → ALLOW only Thailand (+66)
#      — blocks the international premium-rate numbers SMS-pumping attacks target.
#   3. Set a per-phone / daily SMS quota (and billing alert) so a leaked config
#      can't run up an unbounded bill.

# --- Cloudflare R2 (shop logo + cover image storage) ---
# Object storage for shop branding images, served publicly via a CDN-backed
# domain. The app stores only the object KEY in the DB and derives the display
# URL from NEXT_PUBLIC_R2_PUBLIC_BASE_URL, so the public host can change without
# a data migration.
#
# WRITE credentials — server-only (NO NEXT_PUBLIC_ prefix). Create an R2 API
# token scoped to READ+WRITE on the single bucket below:
#   Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API token.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=quego-shop-media
# S3 API endpoint for the account (region is always "auto" for R2):
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
#
# PUBLIC read base — safe in the browser bundle (it only serves public images,
# authorizes nothing). Bind a custom domain to the bucket in the R2 dashboard
# (Settings → Public access → Custom domain), e.g. img.quego.app. No trailing
# slash. For a quick start you may instead enable the managed r2.dev subdomain
# and put that URL here.
#
# SECURITY — REQUIRED go-live hardening on this public host. Uploads are
# magic-byte-validated server-side and the client crops/re-encodes, but a
# direct API caller could still store an image whose trailing bytes are a
# crafted HTML/JS polyglot. Because images are served from THIS origin (not the
# Next app), the app's `X-Content-Type-Options: nosniff` header does NOT cover
# them. So the R2 public domain MUST independently send, on every object
# response (via a Cloudflare Transform Rule / Worker on the custom domain):
#   X-Content-Type-Options: nosniff
#   Content-Disposition: inline
#   Content-Security-Policy: default-src 'none'
# This stops a browser from ever executing a stored object as HTML/JS.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://img.quego.app
