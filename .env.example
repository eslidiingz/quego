# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit secrets.

# --- Supabase (public client, safe to ship to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase service-role key (server-only, bypasses RLS) ---
# Source: https://supabase.com/dashboard/project/_/settings/api-keys
# Required by admin moderation actions, shop session minting, booking
# inserts — anything that needs to write past RLS deny-all policies.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Session signing secret ---
# Minimum 32 chars. Used to sign + verify both the admin and shop session
# JWTs (the JWTs are separated by `aud` claim, not by key). Rotating this
# value invalidates every active session.
ADMIN_SESSION_SECRET=replace-with-32+-char-random-string

# --- Canonical site URL (public, safe in the browser bundle) ---
# Origin used to build shareable absolute links + QR codes (e.g. the shop
# share page). No trailing slash. Falls back to https://$VERCEL_URL on Vercel,
# then http://localhost:4000 in local dev.
NEXT_PUBLIC_SITE_URL=https://queva.app
